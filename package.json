{
  "name": "pdf-kalemi",
  "version": "1.0.0",
  "description": "Kalemle PDF üzerine yazma, sunum ve yapay zeka asistanı (masaüstü + web)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --arm64",
    "dist:x64": "electron-builder --win --x64"
  },
  "author": "Ufuk ASIL",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "local.pdfkalemi",
    "productName": "PDF Kalemi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "voice.js",
      "index.html",
      "app.js",
      "web.js",
      "speech.js",
      "ai.js",
      "aktar.js",
      "ai-logo.png",
      "icon.png",
      "lib/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "PDF-Kalemi-${arch}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Kalemi",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PDF-Kalemi-Kurulum-${arch}.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDFKalemi.pdf",
        "description": "PDF belgesi",
        "role": "Editor"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-node": "1.30.0",
    "espeak-ng": "1.0.2"
  }
}
